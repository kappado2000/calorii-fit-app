rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own subtree — profile, weightEntries, foodLogs,
    // customFoods, recipes, favorites (see project plan's Firestore schema).
    // Only the owning authenticated user may read or write any of it.
    match /users/{userId} {
      // The admin account (see activateAdmin.ts) can additionally READ
      // every top-level profile doc — needed for the admin dashboard's
      // subscriber/premium counts and code-ownership lookups. It cannot
      // write another user's doc from the client (premiumUntil is only
      // ever set server-side by redeemPremiumCode.ts via the Admin SDK,
      // which bypasses these rules entirely), and it gets no special
      // access to any sub-collection (food logs, weight entries, etc.) —
      // this is deliberately the narrowest grant that satisfies the
      // stats requirement, not a blanket admin bypass.
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Access-code doc, one per code (see generatePremiumCode.ts /
    // redeemPremiumCode.ts) — the admin can list/read every code it has
    // ever generated (for the dashboard); every write happens server-side
    // via the Admin SDK only (generation, redemption).
    match /premiumCodes/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Shared nutrition lookup cache — read-only for signed-in users, only
    // ever populated server-side by the lookupNutrition Cloud Function
    // (Admin SDK bypasses these rules entirely).
    match /foodsCache/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Written only by analyzePhoto via the Admin SDK for accuracy
    // monitoring — never read or written directly by clients.
    match /analysisLogs/{document} {
      allow read, write: if false;
    }

    // Per-user daily photo-analysis counter (anti-abuse cap, see
    // analyzePhoto.ts) — top-level, not nested under users/{uid}, precisely
    // so the wildcard rule above can't let a client read/reset its own
    // count. Touched only by the Admin SDK.
    match /photoAnalysisQuota/{document} {
      allow read, write: if false;
    }

    // Per-user daily AI-food-lookup counter (anti-abuse cap, see
    // aiFoodLookup.ts) — same shape/purpose as photoAnalysisQuota above.
    match /aiFoodLookupQuota/{document} {
      allow read, write: if false;
    }

    // Cumulative (never resets) AI-food-lookup counter for a free
    // account's 14-day trial (see isInTrial/aiFoodLookup.ts) — doc id is
    // the uid itself, no date suffix.
    match /aiFoodLookupTrialQuota/{document} {
      allow read, write: if false;
    }

    // App version policy (see core/version) — readable by anyone,
    // including signed-out users on the login screen, since it's the
    // update gate itself. Never written by clients; updated by hand in
    // the Firebase console (or a future release script) with each build.
    match /appConfig/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
